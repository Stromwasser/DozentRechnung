# --- Nur lokal (ohne Supabase) ---
# Entweder beide Zeilen leer lassen / auskommentieren …
# VITE_SUPABASE_URL=
# VITE_SUPABASE_ANON_KEY=
# … oder ausdrücklich:
# VITE_LOCAL_MODE=true
# Daten: localStorage + IndexedDB (PDFs) im Browser.

# --- Mit Supabase ---
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key
